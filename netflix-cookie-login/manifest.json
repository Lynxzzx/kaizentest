{
  "manifest_version": 3,
  "name": "Netflix Cookie Login",
  "version": "1.0",
  "description": "Faz login na Netflix importando cookies de sessão no formato Netscape/cookies.txt",
  "permissions": [
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "https://*.netflix.com/*",
    "http://*.netflix.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Netflix Cookie Login",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
